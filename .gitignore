# macOS
.DS_Store

# Python virtualenv и кэш
.venv*/
.venv_krab_ear/
KrabEar/.venv_krab_ear/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/

# Swift build/runtime
native/KrabEarAgent/.build/
native/runtime/
native/Frameworks/

# Bundled Python runtime (scripts/build_bundled_runtime.command output, ~2.5GB
# — build artifact, never commit). build/.runtime_cache/ caches the downloaded
# python-build-standalone tarball across rebuilds.
build/

# Runtime-логи и pid
*.log
*.pid
KrabEar/krab_ear.log
krab_ear_manual.log

# Временные данные и отчеты
voice_cache/
KrabEar/voice_cache/
docs/reports/*.md
docs/reports/*.json

# Архивы и бэкапы
_ARCHIVE_NON_KRAB_EAR_2026-02-11/
_STABLE_BACKUPS/

# Локальные служебные каталоги
.coordination/

# Дополнительные venv (новые)
.venv_krab_ear_clean/
venv_clean/
venv/

# Agent / session state
.claude/
.ralphy/
.remember/
.claire/

# Runtime artifacts из E4/E5
data/
server_log.txt
test_*.wav
test_audio.wav
test_whisper.wav
check_status.command
KrabEar/tests/benchmark_results.json
.benchmarks/

# Runtime incident reports (written by smoke-test routines)
.smoke_incidents/

# Distribution build artifacts (DMG, staging app copy)
dist/

# Runtime launchd log directory (files already matched by *.log above,
# but directory listing itself would show in git status)
logs/

# poc_diarization — отдельный sub-git, не трогаем
poc_diarization/

# Secrets
.env
.env.*
KrabEar/.env

# Antigravity MCP config — holds a real token (Antigravity's schema has no env-var
# interpolation); .agents/mcp_config.json.example is the tracked template.
# .cursor/mcp.json is NOT ignored — it uses ${env:VAR} interpolation, no literal secret.
.agents/mcp_config.json

# Test bundle fixtures — created during local Swift builds
native/_tmp_bundle_test/

# Wave 47 security audit (step 3): bench result outputs may contain
# user voice transcripts and other sensitive content. Keep local only.
docs/llm-bench-results-*.md
docs/llm-bench-results-*.json
/tmp/r*_bench.log

# Wave 47 CRIT-1 / W821 (security-audit-2026-05-12.md line 28):
# Bench driver scripts previously contained hardcoded LM Studio tokens
# (fixed to env-read, but files may regress). Keep local only — not in repo.
scripts/r*_bench.py
worktrees/

# Visual-companion брейнсторм-сессии (runtime, не коммитить)
.superpowers/

# Worktrees для subagent-driven исполнения (superpowers:using-git-worktrees)
.worktrees/
