#!/bin/zsh
# ------------------------------------------------------------------
# Открывает панель истории Krab Ear.
# Если агент уже запущен, отправляет команду show_history.
# Если не запущен, стартует агент сразу с открытием панели.
# ------------------------------------------------------------------

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
"$ROOT_DIR/scripts/start_agent.command" --show-history "$@"
