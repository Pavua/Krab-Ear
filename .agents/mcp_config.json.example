{
  "mcpServers": {
    "github": {
      "serverUrl": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ВСТАВЬ_СВОЙ_GITHUB_PERSONAL_ACCESS_TOKEN"
      }
    },
    "sentry": {
      "serverUrl": "https://mcp.sentry.dev/mcp",
      "headers": {
        "Authorization": "Sentry-Bearer ВСТАВЬ_СВОЙ_SENTRY_AUTH_TOKEN"
      }
    }
  }
}
