from __future__ import annotations

import json
import tempfile
import unittest
from pathlib import Path
from unittest import mock

from backend.plaintext_export_authorization import (
    POLICY_REVISION_KEY,
    REASON_PLAINTEXT_SESSION_EXPIRED,
    PlaintextExportAuthorizer,
    PolicyState,
)
from backend.state_store import (
    StateStore,
    StateStoreSettingsCorruptError,
)

ENCRYPTION_KEY = "history_encryption_enabled"
PRIVACY_KEY = "privacy_mode_enabled"

VALID_REVISION = "0123456789abcdef0123456789abcdef"
HOSTILE_REVISION = "0" * 32


def _profile(encryption: bool = False, privacy: bool = False) -> dict:
    return {
        ENCRYPTION_KEY: encryption,
        PRIVACY_KEY: privacy,
        POLICY_REVISION_KEY: VALID_REVISION,
    }


def _seed_known(data_dir: Path, *, encryption: bool = False, privacy: bool = False) -> None:
    (data_dir / "settings.json").write_text(
        json.dumps(_profile(encryption, privacy)), encoding="utf-8"
    )


def _real_settings_service(store: StateStore):
    from backend.settings_backup import SettingsBackup
