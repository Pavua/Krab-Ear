class TestHistoryRestoreSettingsViaCommit(_CommitPathsFixture):
    """П.11: settings-часть handle_restore_history — validated commit, не copy2."""

    def _make_legacy_backup(self, *, settings_payload: dict) -> Path:
        backups_root = self.data_dir / "backups"
        backup_dir = backups_root / "backup_TEST"
        backup_dir.mkdir(parents=True, exist_ok=True)
        (backup_dir / "history.ndjson").write_text("", encoding="utf-8")
        (backup_dir / "backup_meta.json").write_text(
            json.dumps({"backup_ts": "2026-01-01T00:00:00Z"}), encoding="utf-8"
        )
        (backup_dir / "settings.json").write_text(
            json.dumps(settings_payload), encoding="utf-8"
        )
        return backup_dir

    def test_restore_settings_goes_through_commit_not_copy2(self):
        _seed_known(self.data_dir, encryption=False)
        backup_settings = dict(_profile(True, False))
        backup_settings[POLICY_REVISION_KEY] = HOSTILE_REVISION
        backup_dir = self._make_legacy_backup(settings_payload=backup_settings)
        svc = _real_history_service(self.store)
        with mock.patch("shutil.copy2") as copy2:
            # history.ndjson и aux-файлы идут через copy2 — это нормально;
            # settings.json через copy2 идти НЕ должен (иначе hostile revision сохранится).
            result = svc.handle_restore_history(
                {"backup_path": str(backup_dir), "restore_settings": True}
            )
            for call in copy2.call_args_list:
                args, _kwargs = call
                self.assertNotIn("settings.json", str(args[0]),
                                 f"settings copy2 bypass жив: {call}")
                self.assertNotIn("settings.json", str(args[1]),
                                 f"settings copy2 bypass жив: {call}")
        self.assertGreater(result.get("restored_entries", 0), -1)
        on_disk = self.on_disk()
        self.assertNotEqual(on_disk[POLICY_REVISION_KEY], HOSTILE_REVISION)
        self.assertTrue(on_disk[ENCRYPTION_KEY] is True)
        self.assertIs(self.snapshot().state, PolicyState.KNOWN_ON)

    def test_restore_settings_incomplete_backup_stays_unknown(self):
        _seed_known(self.data_dir, encryption=False)
        backup_dir = self._make_legacy_backup(
            settings_payload={"wake_word_enabled": True}
        )
        svc = _real_history_service(self.store)
        svc.handle_restore_history(
            {"backup_path": str(backup_dir), "restore_settings": True}
        )
        # Явный restore с неполным backup: запись идёт (validated repair),
        # но профиль по содержимому UNKNOWN fail-closed — не KNOWN_OFF.
        # (Единый commit минтит ревизию, но флагов в backup нет.)
        snap = self.snapshot()
        self.assertIs(snap.state, PolicyState.UNKNOWN, snap)

    def test_encrypted_snapshot_restore_settings_stays_refused(self):
        """Запрет encrypted_snapshot.py:3034 цел: restore_settings=True отклонён."""
        from backend.encrypted_snapshot import (
            REASON_RESTORE_SETTINGS_UNSUPPORTED,
            SnapshotOperationRefused,
            restore_encrypted_snapshot,
        )

        with self.assertRaises(SnapshotOperationRefused) as ctx:
            restore_encrypted_snapshot(
                data_dir=self.data_dir,
                backups_root=self.data_dir / "backups",
                snapshot_dir=self.data_dir / "backups" / "nope",
                crypto=object(),
                restore_settings=True,
            )
        self.assertEqual(ctx.exception.reason, REASON_RESTORE_SETTINGS_UNSUPPORTED)


class TestIntegrityRepairViaCommit(_CommitPathsFixture):
    """П.10/17: repair settings — центральный commit, revision минтится, UNKNOWN."""

    def test_repair_corrupt_settings_mints_revision_and_stays_unknown(self):
        (self.data_dir / "settings.json").write_bytes(b"[1, 2, 3]")
        from backend.integrity_checker import IntegrityChecker

        checker = IntegrityChecker()
        report = checker.check_integrity(self.data_dir)
        result = checker.repair(self.data_dir, report)
        self.assertGreaterEqual(result.fixed, 1)
        on_disk = self.on_disk()
        self.assertIn(POLICY_REVISION_KEY, on_disk)
        self.assertNotEqual(on_disk[POLICY_REVISION_KEY], HOSTILE_REVISION)
        snap = self.snapshot()
        # Главное: НЕ KNOWN_OFF. Пустой explicit-контент + ревизия = MISSING_KEY UNKNOWN.
        self.assertIs(snap.state, PolicyState.UNKNOWN, snap)

    def test_repair_does_not_use_shared_tmp_name(self):
        (self.data_dir / "settings.json").write_bytes(b"not json {{{")
        from backend.integrity_checker import IntegrityChecker

        checker = IntegrityChecker()
        report = checker.check_integrity(self.data_dir)
        checker.repair(self.data_dir, report)
        leftovers = [p.name for p in self.data_dir.iterdir() if p.name.endswith(".tmp")]
        self.assertEqual(leftovers, [], leftovers)


