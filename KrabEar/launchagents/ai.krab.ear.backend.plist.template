<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template for ai.krab.ear.backend launchd job (Variant B supervisor).

  Why launchd instead of Swift hand-rolled supervisor:
  - Swift BackendSupervisor only triggers restart on IPC call failure;
    many call sites bypass `callWithRecovery()`, so the GUI "freezes" while
    backend is dead until the user clicks "Restart".
  - launchd KeepAlive=true respawns the process within ThrottleInterval (5s)
    of any death (crash, OOM, kill -9, exit), independent of any IPC traffic.
  - This is the same supervision model Apple uses for system daemons.

  Install via: scripts/install_backend_launchagent.command
  Stop via:    launchctl bootout gui/$UID/ai.krab.ear.backend
  Status via:  launchctl print gui/$UID/ai.krab.ear.backend
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.krab.ear.backend</string>

  <!-- S3/Р9: запускаем main.py, а НЕ backend/service.py напрямую. Прямой запуск
       делает service.py модулем __main__, а rest_server.py:37 импортирует
       backend.service — и при включённом in-process REST файл исполняется
       ВТОРЫМ экземпляром модуля: в процессе живут два разных класса
       BackendService. Сегодня безвредно, но любой module-level синглтон,
       добавленный в service.py, тихо раздвоится. -->
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_ROOT__/.venv_krab_ear/bin/python3</string>
    <string>__PROJECT_ROOT__/KrabEar/main.py</string>
    <string>--data-dir</string>
    <string>__HOME__/Library/Application Support/KrabEar</string>
    <string>--socket-path</string>
    <string>__HOME__/Library/Application Support/KrabEar/krabear.sock</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <!-- 5s — компромисс: достаточно быстро для пользователя, недостаточно
       часто чтобы macOS считал «спам перезапусков» (>10/мин = throttle). -->
  <key>ThrottleInterval</key>
  <integer>5</integer>

  <!-- Backend стартует ~5-8 секунд (загружает Whisper + pyannote модели).
       Дать запас на graceful shutdown при bootout.

       R2-фикс 4 (финальное adversarial-ревью волны S3, 2026-07-31): поднято
       15 -> 25. Посчитанный ПОСЛЕДОВАТЕЛЬНЫЙ бюджет останова (порядок
       вызовов — _shutdown_backend/BackendService.close() в service.py)
       складывается из ШЕСТИ слагаемых, а не трёх, как считал прежний
       вариант этого комментария:
         _IPC_DRAIN_BUDGET_SEC=8.0            (service.py, IPC-дренаж)
         RestWatchdog.stop() join=2.0         (rest_watchdog.py, STOP_JOIN_TIMEOUT_SEC)
         REST_DRAIN_BUDGET_SEC=2.0            (rest_inprocess.py)
         SERVE_ENTER_TIMEOUT_SEC=2.0          (rest_inprocess.py, барьер входа в serve_forever)
         SHUTDOWN_JOIN_TIMEOUT_SEC=5.0        (rest_inprocess.py, join треда сервера)
         EventBridge.stop() join=5.0          (event_bridge.py, STOP_JOIN_TIMEOUT_SEC)
       Сумма = 24.0с. Прежние 15 давали РОВНО 15.0 при трёх слагаемых — уже
       нулевой запас, а с учётом трёх пропущенных слагаемых бюджет попросту
       не помещался бы (24 > 15), обрезая teardown раньше собственного
       дедлайна. 25 даёт ~1с запаса сверх посчитанного максимума. Формула —
       единый источник правды в test_rest_inprocess_drain_budget_S3_task5.py
       (импортирует именованные константы напрямую, не дублирует числа) —
       менять ExitTimeOut без синхронной правки этого теста нельзя. -->
  <key>ExitTimeOut</key>
  <integer>25</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Wave 70: launchd не наследует shell PATH → ffmpeg не найден в subprocess.
         engine._find_ffmpeg_path() имеет hardcoded fallback /opt/homebrew/bin/ffmpeg,
         но gigaam_worker и gigaam lib используют PATH напрямую. Defense-in-depth. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>

    <key>PYTHONPATH</key>
    <string>__PROJECT_ROOT__/KrabEar</string>

    <!-- S3/Р3: settings.DATA_DIR обязан совпадать с аргументом
         <hyphen><hyphen>data-dir выше. Backend передаёт каталог АРГУМЕНТОМ (он
         доходит только до StateStore), а всё, что читает settings.DATA_DIR —
         rest_server, cloud_stt, cloud_rewriter, startup_diagnostics — смотрит
         сюда. Пока REST жил отдельным юнитом, переменная была в его плисте
         (с 16-07); при слиянии процессов она обязана быть здесь, иначе
         половина процесса читает ~/.krab_ear_data, а история пишется в
         канонический каталог. Значение сверяется побайтово тестом
         test_backend_plist_data_dir_parity_S3.py. -->
    <key>KRAB_EAR_DATA_DIR</key>
    <string>__HOME__/Library/Application Support/KrabEar</string>

    <!-- Diarization (pyannote/speaker-diarization-3.1) требует HF token. -->
    <key>HF_TOKEN</key>
    <string>__HF_TOKEN__</string>
    <key>KRAB_EAR_HF_TOKEN</key>
    <string>__HF_TOKEN__</string>

    <!-- D.7 dictation prompt: пунктуация, числа, бренды латиницей. -->
    <key>KRAB_EAR_TRANSCRIBE_PROMPT</key>
    <string>Ты транскрибируешь русскую речь владельца по имени Pablito. Пиши грамотно и с пунктуацией. Ставь точки в конце предложений, запятые перед "что", "который", "если", "но", "потому что", "чтобы", "когда". Вопросы заканчивай знаком вопроса. Числа всегда пиши цифрами (47 евро, 30 минут). Время пиши в формате ЧЧ:ММ (15:00, 14:30), не 15.00. Названия брендов и продуктов пиши латиницей: Mercadona, Krab, Krab Ear, Krab Voice Gateway, Antigravity, OpenClaw, Hammerspoon, Pyannote, Pyrofork, Telegram, GitHub, FastAPI, Claude, Anthropic, MacBook, Python, Whisper, MLX. Имена: Pablito, yung_nagato, p0lrd. Сохраняй смысл и естественные паузы. Не добавляй слов которых нет, не повторяй фразы.</string>

    <!-- 2026-04-09 incident fix: HF resolve-cache proxy periodically returns 503, -->
    <!-- breaking mlx-whisper even on local cache hits (HEAD revision check).      -->
    <!-- OFFLINE=1 forces huggingface_hub to use only local cache without HEAD.   -->
    <!-- Remove if HF stabilises and you need on-demand model downloads.           -->
    <key>HF_HUB_OFFLINE</key>
    <string>1</string>
    <key>TRANSFORMERS_OFFLINE</key>
    <string>1</string>

    <!-- 2026-04-09 incident fix: whisper-large-v3-turbo cache can be broken           -->
    <!-- (incomplete download). Override balanced profile to whisper-large-v3-mlx,    -->
    <!-- which is the full model guaranteed to be locally available. Preview thread    -->
    <!-- previously stalled 6 cycles on "Локальные модели недоступны" fallbacks.      -->
    <!-- Remove this override when v3-turbo is re-downloaded and verified complete.   -->
    <key>KRAB_EAR_MODEL_BALANCED</key>
    <string>mlx-community/whisper-large-v3-mlx</string>

    <!-- 2026-05-09 fix: LLM rewriter request timeout. Старый plist имел 5.0
         (откуда возникло — неизвестно, возможно legacy install). При длинных
         диктовках (>200 chars) gemma-4-E4B vision multimodal MLX отвечает 5-15s
         в "thinking" фазе → 5s timeout убивал rewrite → user видит raw STT с
         "0Х" вместо "Их" (digit hallucinations не fixed). 120s безопасно для
         cold load под нагрузкой. -->
    <key>KRAB_EAR_LLM_TIMEOUT_SEC</key>
    <string>120.0</string>

    <!-- fix/tts-ru-accent-routing (2026-07-12): включает Silero (RU primary
         neural TTS, voice=Milena-quality) + Kokoro (EN fallback) вместо
         дефолтного TTS_ENABLED=False (только macOS `say`). Двухслойный
         Silero-баг (v4 API tuple-unpack + in-place .to() возвращал None)
         исправлен в 491a3a2e — Silero теперь грузится и синтезирует
         корректно, поэтому новые установки должны включать его как primary.
         Без этого флага RU-озвучка (например ConversationErrorAnnouncer)
         шла напрямую через macOS `say`, что само по себе не баг (см. фикс
         RU-voice-default в tts_service.py), но лишает RU-речь качества
         нейросетевого Silero-голоса. -->
    <key>KRAB_EAR_TTS_ENABLED</key>
    <string>1</string>
  </dict>

  <!-- Sentry KRAB-EAR-BACKEND-24 (2026-08-08): OSError [Errno 24] Too many
       open files на StateStore._lock() под system-wide overload. Без явного
       SoftResourceLimits процесс наследует дефолтный launchd soft-лимит
       (`launchctl limit maxfiles` = 256) — тонкий запас для backend, держащего
       десятки file-backed NDJSON-хранилищ + IPC socket-соединения + per-lock
       fd (StateStore/error_bus/translation_cache/webhook_manager и т.д.). -->
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>4096</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>__PROJECT_ROOT__/logs/krab-ear-backend.out.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_ROOT__/logs/krab-ear-backend.err.log</string>
</dict>
</plist>
