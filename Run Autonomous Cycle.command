#!/bin/zsh
# ------------------------------------------------------------------
# Ярлык для автономного цикла проверки Krab Ear.
# Пример: двойной клик или запуск с параметрами:
#   ./Run\ Autonomous\ Cycle.command 800 3
# где 800 = soak-циклы, 3 = количество полных итераций.
# ------------------------------------------------------------------

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
"$ROOT_DIR/scripts/run_autonomous_cycle.command" "$@"
